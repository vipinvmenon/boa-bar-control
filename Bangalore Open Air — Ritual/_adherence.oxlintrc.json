{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/content/**",
              "components/marks/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Metal Mania|Rye|Anton|Oswald|Archivo))/i]",
        "message": "Font not provided by the design system. Available: Metal Mania, Rye, Anton, Oswald, Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|children|key|ref|className|style|children)$/]",
        "message": "<CTAButton> doesn't accept that prop. Declared props: variant, size, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|green)$/]",
        "message": "<CTAButton> variant must be one of 'primary' | 'ghost' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<CTAButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAButton'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<CTAButton> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateVenueBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|align|bordered|glow|style|key|ref|className|style|children)$/]",
        "message": "<DateVenueBar> doesn't accept that prop. Declared props: items, align, bordered, glow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateVenueBar'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<DateVenueBar> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeadlineBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|headline|subhead|accent|align|size|style|key|ref|className|style|children)$/]",
        "message": "<HeadlineBlock> doesn't accept that prop. Declared props: eyebrow, headline, subhead, accent, align, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeadlineBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<HeadlineBlock> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeadlineBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<HeadlineBlock> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Artist'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tier|key|ref|className|style|children)$/]",
        "message": "<Artist> doesn't accept that prop. Declared props: name, tier."
      },
      {
        "selector": "JSXOpeningElement[name.name='Artist'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:headliner|support|special)$/]",
        "message": "<Artist> tier must be one of 'headliner' | 'support' | 'special'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|size|variant|glow|style|key|ref|className|style|children)$/]",
        "message": "<LogoLockup> doesn't accept that prop. Declared props: src, size, variant, glow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoLockup'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<LogoLockup> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoLockup'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|mono)$/]",
        "message": "<LogoLockup> variant must be one of 'full' | 'mono'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Motif'] > JSXAttribute > JSXIdentifier[name!=/^(?:aura|texture|wash|intensity|style|key|ref|className|style|children)$/]",
        "message": "<Motif> doesn't accept that prop. Declared props: aura, texture, wash, intensity, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Motif'] > JSXAttribute[name.name='texture'] > Literal[value!=/^(?:grain|halftone|none)$/]",
        "message": "<Motif> texture must be one of 'grain' | 'halftone' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceSticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|price|strike|tone|rotate|style|key|ref|className|style|children)$/]",
        "message": "<PriceSticker> doesn't accept that prop. Declared props: kicker, price, strike, tone, rotate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceSticker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|gold)$/]",
        "message": "<PriceSticker> tone must be one of 'green' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SponsorLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|height|key|ref|className|style|children)$/]",
        "message": "<SponsorLogo> doesn't accept that prop. Declared props: src, alt, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tier|price|tone|soldOut|style|key|ref|className|style|children)$/]",
        "message": "<TicketBadge> doesn't accept that prop. Declared props: tier, price, tone, soldOut, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|gold|ghost)$/]",
        "message": "<TicketBadge> tone must be one of 'green' | 'gold' | 'ghost'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
